{
  "name": "@sa/api",
  "version": "0.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --watch -r @swc-node/register src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "jest --selectProjects unit",
    "test": "jest --runInBand",
    "db:migrate": "node -r @swc-node/register src/db/migrate.ts",
    "db:seed": "node -r @swc-node/register src/db/seed.ts",
    "openapi": "node -r @swc-node/register src/openapi.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@node-rs/argon2": "^2.0.2",
    "@sa/domain": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "jose": "^5.9.6",
    "otplib": "^12.0.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@sa/config": "workspace:*",
    "@swc-node/register": "^1.10.9",
    "@swc/core": "^1.10.1",
    "@swc/jest": "^0.2.37",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "typescript": "~5.7.2"
  }
}

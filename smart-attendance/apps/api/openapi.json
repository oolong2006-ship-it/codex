  "info": {
    "title": "Thabt — Smart Attendance OS API",
    "description": "واجهة المنصة. الأخطاء بصيغة { error: { code, message_ar, message_en } }.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string",
            "description": "البريد أو رقم الجوال"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "identifier",
          "password"
        ]
      },
      "MfaTokenDto": {
        "type": "object",
        "properties": {
          "mfa_token": {
            "type": "string"
          }
        },
        "required": [
          "mfa_token"
        ]
      },
      "MfaVerifyDto": {
        "type": "object",
        "properties": {
          "mfa_token": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "example": "123456"
          }
        },
        "required": [
          "mfa_token",
          "code"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refresh_token": {
            "type": "string"
          }
        },
        "required": [
          "refresh_token"
        ]
      },
      "IssueActivationCodeDto": {
        "type": "object",
        "properties": {
          "employee_id": {
            "type": "string"
          }
        },
        "required": [
          "employee_id"
        ]
      },
      "ChallengeDto": {
        "type": "object",
        "properties": {
          "purpose": {
            "type": "string",
            "enum": [
              "BIND",
              "CHANGE"
            ]
          }
        },
        "required": [
          "purpose"
        ]
      },
      "DeviceRegistrationDto": {
        "type": "object",
        "properties": {
          "challenge_id": {
            "type": "string"
          },
          "platform": {
            "type": "string",
            "enum": [
              "ios",
              "android"
            ]
          },
          "key_id": {
            "type": "string",
            "description": "App Attest key id أو معرف مفتاح Keystore"
          },
          "attestation": {
            "type": "object",
            "description": "حمولة attestation الخاصة بالمنصة، وتتضمن nonce التحدي",
            "additionalProperties": true
          },
          "android_id_hash": {
            "type": "string",
            "description": "HMAC لـ ANDROID_ID من التطبيق (لا قيمة خام)"
          },
          "devicecheck_bit0": {
            "type": "boolean"
          },
          "model": {
            "type": "string"
          },
          "os_version": {
            "type": "string"
          }
        },
        "required": [
          "challenge_id",
          "platform",
          "key_id",
          "attestation"
        ]
      },
      "BindDto": {
        "type": "object",
        "properties": {
          "activation_code": {
            "type": "string",
            "example": "K7P3-XQ9M"
          },
          "device": {
            "$ref": "#/components/schemas/DeviceRegistrationDto"
          }
        },
        "required": [
          "activation_code",
          "device"
        ]
      },
      "ChangeRequestDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "enum": [
              "LOST",
              "STOLEN",
              "BROKEN",
              "UPGRADE"
            ]
          },
          "note": {
            "type": "string"
          },
          "device": {
            "$ref": "#/components/schemas/DeviceRegistrationDto"
          }
        },
        "required": [
          "reason",
          "device"
        ]
      },
      "CreateTenantDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string",
            "example": "acme-restaurants"
          },
          "admin_email": {
            "type": "string",
            "description": "بريد مسؤول العميل الأول"
          }
        },
        "required": [
          "name",
          "slug",
          "admin_email"
        ]
      }
    }
  }
}

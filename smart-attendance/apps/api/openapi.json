  "info": {
    "title": "Thabt — Smart Attendance OS API",
    "description": "واجهة المنصة. الأخطاء بصيغة { error: { code, message_ar, message_en } }.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string",
            "description": "البريد أو رقم الجوال"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "identifier",
          "password"
        ]
      },
      "MfaTokenDto": {
        "type": "object",
        "properties": {
          "mfa_token": {
            "type": "string"
          }
        },
        "required": [
          "mfa_token"
        ]
      },
      "MfaVerifyDto": {
        "type": "object",
        "properties": {
          "mfa_token": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "example": "123456"
          }
        },
        "required": [
          "mfa_token",
          "code"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refresh_token": {
            "type": "string"
          }
        },
        "required": [
          "refresh_token"
        ]
      },
      "IssueActivationCodeDto": {
        "type": "object",
        "properties": {
          "employee_id": {
            "type": "string"
          }
        },
        "required": [
          "employee_id"
        ]
      },
      "ChallengeDto": {
        "type": "object",
        "properties": {
          "purpose": {
            "type": "string",
            "enum": [
              "BIND",
              "CHANGE"
            ]
          }
        },
        "required": [
          "purpose"
        ]
      },
      "DeviceRegistrationDto": {
        "type": "object",
        "properties": {
          "challenge_id": {
            "type": "string"
          },
          "platform": {
            "type": "string",
            "enum": [
              "ios",
              "android"
            ]
          },
          "key_id": {
            "type": "string",
            "description": "App Attest key id أو معرف مفتاح Keystore"
          },
          "attestation": {
            "type": "object",
            "description": "حمولة attestation الخاصة بالمنصة، وتتضمن nonce التحدي",
            "additionalProperties": true
          },
          "android_id_hash": {
            "type": "string",
            "description": "HMAC لـ ANDROID_ID من التطبيق (لا قيمة خام)"
          },
          "devicecheck_bit0": {
            "type": "boolean"
          },
          "model": {
            "type": "string"
          },
          "os_version": {
            "type": "string"
          }
        },
        "required": [
          "challenge_id",
          "platform",
          "key_id",
          "attestation"
        ]
      },
      "BindDto": {
        "type": "object",
        "properties": {
          "activation_code": {
            "type": "string",
            "example": "K7P3-XQ9M"
          },
          "device": {
            "$ref": "#/components/schemas/DeviceRegistrationDto"
          }
        },
        "required": [
          "activation_code",
          "device"
        ]
      },
      "ChangeRequestDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "enum": [
              "LOST",
              "STOLEN",
              "BROKEN",
              "UPGRADE"
            ]
          },
          "note": {
            "type": "string"
          },
          "device": {
            "$ref": "#/components/schemas/DeviceRegistrationDto"
          }
        },
        "required": [
          "reason",
          "device"
        ]
      },
      "CreateTenantDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string",
            "example": "acme-restaurants"
          },
          "admin_email": {
            "type": "string",
            "description": "بريد مسؤول العميل الأول"
          }
        },
        "required": [
          "name",
          "slug",
          "admin_email"
        ]
      },
      "LatLngDto": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number"
          },
          "lng": {
            "type": "number"
          }
        },
        "required": [
          "lat",
          "lng"
        ]
      },
      "GeofenceDto": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "CIRCLE",
              "POLYGON"
            ]
          },
          "center": {
            "$ref": "#/components/schemas/LatLngDto"
          },
          "radius_m": {
            "type": "number",
            "description": "نصف القطر بالأمتار"
          },
          "polygon": {
            "description": "رؤوس المضلع (يُغلق تلقائيًا)",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LatLngDto"
            }
          },
          "tolerance_m": {
            "type": "number",
            "description": "هامش السماح t بالأمتار (specs §B)",
            "default": 0
          }
        },
        "required": [
          "kind"
        ]
      },
      "CreateWorkLocationDto": {
        "type": "object",
        "properties": {
          "branch_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "assurance_level": {
            "type": "string",
            "enum": [
              "STANDARD",
              "HIGH",
              "STRICT"
            ]
          },
          "wifi_uplift_enabled": {
            "type": "boolean"
          },
          "geofence": {
            "$ref": "#/components/schemas/GeofenceDto"
          }
        },
        "required": [
          "branch_id",
          "name",
          "geofence"
        ]
      },
      "AssignSiteDto": {
        "type": "object",
        "properties": {
          "work_location_id": {
            "type": "string"
          },
          "valid_from": {
            "type": "string"
          },
          "valid_to": {
            "type": "string"
          }
        },
        "required": [
          "work_location_id"
        ]
      },
      "PunchSampleDto": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number"
          },
          "lng": {
            "type": "number"
          },
          "accuracy_m": {
            "type": "number",
            "description": "دقة أفقية بالأمتار"
          },
          "captured_at": {
            "type": "string",
            "description": "وقت التقاط العينة على الهاتف (ISO8601)"
          },
          "provider": {
            "type": "string",
            "enum": [
              "gps",
              "fused",
              "network"
            ]
          },
          "is_mock": {
            "type": "boolean"
          },
          "source_info": {
            "type": "object",
            "description": "iOS: isSimulatedBySoftware / isProducedByAccessory"
          }
        },
        "required": [
          "lat",
          "lng",
          "accuracy_m",
          "captured_at"
        ]
      },
      "PunchDto": {
        "type": "object",
        "properties": {
          "challenge_id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "CLOCK_IN",
              "CLOCK_OUT",
              "BREAK_START",
              "BREAK_END"
            ]
          },
          "location_samples": {
            "description": "من 1 إلى 3 عينات طازجة بعد التحدي",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PunchSampleDto"
            }
          },
          "client_time": {
            "type": "string"
          },
          "client_tz": {
            "type": "string"
          },
          "app_version": {
            "type": "string"
          },
          "os": {
            "type": "string",
            "enum": [
              "ios",
              "android"
            ]
          },
          "os_version": {
            "type": "string"
          },
          "offline": {
            "type": "boolean",
            "default": false
          },
          "accuracy_authorization": {
            "type": "string",
            "enum": [
              "full",
              "reduced",
              "approximate"
            ]
          },
          "attestation": {
            "type": "object",
            "description": "App Attest assertion أو توقيع Keystore + Play Integrity"
          }
        },
        "required": [
          "challenge_id",
          "type",
          "location_samples",
          "app_version",
          "os",
          "attestation"
        ]
      },
      "ExceptionRequestDto": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "DECISION_OVERRIDE",
              "MISSING_PUNCH"
            ]
          },
          "event_id": {
            "type": "string",
            "description": "الحدث المطلوب تصحيح قراره (DECISION_OVERRIDE)"
          },
          "punch_type": {
            "type": "string",
            "enum": [
              "CLOCK_IN",
              "CLOCK_OUT",
              "BREAK_START",
              "BREAK_END"
            ]
          },
          "punch_at": {
            "type": "string",
            "description": "وقت البصمة المنسية (ISO8601)"
          },
          "reason": {
            "type": "string",
            "description": "السبب"
          }
        },
        "required": [
          "kind",
          "reason"
        ]
      },
      "DecisionDto": {
        "type": "object",
        "properties": {
          "note": {
            "type": "string"
          }
        }
      },
      "ReopenDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "description": "سبب إعادة الفتح"
          }
        },
        "required": [
          "reason"
        ]
      }
    }
  }
}

# لا أسرار حقيقية هنا. انسخه إلى .env للتطوير.
APP_ENV=development
PORT=3000
# مالك المخطط (migrations فقط)
DATABASE_URL=postgres://sa_owner:sa_owner_dev@localhost:54329/smart_attendance
# دور التطبيق: يخضع لـ RLS (لا BYPASSRLS)
DATABASE_APP_URL=postgres://sa_app:sa_app_dev@localhost:54329/smart_attendance
# دور المنصة: عمليات Super Admin فقط
DATABASE_PLATFORM_URL=postgres://sa_platform:sa_platform_dev@localhost:54329/smart_attendance
REDIS_URL=redis://localhost:63799
# ولّد قيمة عشوائية >= 32 بايت: openssl rand -base64 48
JWT_SECRET=dev-only-change-me-dev-only-change-me-0000
# fake مسموح في development/test فقط؛ الإنتاج يرفض التشغيل به
ATTESTATION_ADAPTER=fake
# كلمة مرور حسابات seed (تطوير فقط)
SEED_PASSWORD=Dev-Only-Pass-123
# مفتاح تشفير أسرار TOTP (32 بايت base64): openssl rand -base64 32
MFA_ENC_KEY=ZGV2LW9ubHktbWZhLWtleS0zMi1ieXRlcy1sb25nISE=
# مفتاح HMAC لرموز التفعيل والتحديات: openssl rand -base64 32
CODE_HMAC_KEY=ZGV2LW9ubHktY29kZS1obWFjLWtleS0zMmJ5dGVzISE=

{
  "name": "@majlis/db",
  "version": "0.0.0",
  "private": true,
  "description": "Database schema and client (Drizzle + PostgreSQL + pgvector)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/migrate-cli.js",
    "db:seed": "node dist/seed-cli.js"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.0",
    "pg": "^8.23.0",
    "@majlis/interviewer": "workspace:*",
    "@majlis/providers": "workspace:*",
    "@majlis/analysis": "workspace:*"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.0",
    "@types/pg": "^8.23.0"
  }
}

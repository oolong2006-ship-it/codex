{
  "name": "@majlis/interviewer",
  "version": "0.0.0",
  "private": true,
  "description": "Interview state machine and interviewer prompt builder",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "phrases",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@majlis/dialect": "workspace:*",
    "@majlis/providers": "workspace:*",
    "yaml": "^2.8.0"
  }
}

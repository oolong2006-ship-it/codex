# ─── Majlis environment template ───────────────────────────────────────────
# Copy to .env and fill locally. Never commit real values.

NODE_ENV=development

# Data residency (PDPL). Must point to a region inside the Kingdom in production.
# Kept as a variable on purpose — no region is hard-coded anywhere in the code.
DATA_REGION=

# Database (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql://majlis:majlis_dev_password@localhost:5432/majlis


# Object storage for recordings (S3-compatible; MinIO locally)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=majlis-recordings
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Server-side encryption key id for recordings at rest
STORAGE_KMS_KEY_ID=

# ─── Provider adapters ─────────────────────────────────────────────────────
# Each is selected by name; "mock" is the default and needs no keys.
ASR_PROVIDER=mock
TTS_PROVIDER=mock
LLM_PROVIDER=mock
TELEPHONY_PROVIDER=mock
WHATSAPP_PROVIDER=mock

# Self-hosted adapters ("openai-compatible") — servers we run inside the Kingdom.
# Each real adapter must declare <KIND>_LOCATION=in-kingdom|local or the gateway refuses to start.
ASR_LOCATION=
ASR_BASE_URL=
ASR_MODEL=
ASR_API_KEY=
TTS_LOCATION=
TTS_BASE_URL=
TTS_MODEL=
TTS_API_KEY=
TTS_VOICE_MALE=
TTS_VOICE_FEMALE=
# PCM sample rate the TTS server returns (and the browser plays).
TTS_SAMPLE_RATE=24000
# Embeddings for the consumer memory: BAAI/bge-m3 (or multilingual-e5-large), 1024 dims.
EMBEDDING_PROVIDER=mock
EMBEDDING_LOCATION=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
# e5 models expect "query: " / "passage: "; bge-m3 needs none.
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOCUMENT_PREFIX=
# Analysis and memory
PERSONA_MIN_SESSIONS=3
MEMORY_MIN_SIMILARITY=0.1
LLM_LOCATION=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ─── Services ──────────────────────────────────────────────────────────────
# Public base URL of the web app (used in invite links and QR codes).
WEB_PUBLIC_URL=http://localhost:3000

# First organization owner, created by `pnpm --filter @majlis/db db:seed`.
SEED_EMAIL=
SEED_PASSWORD=
SEED_ORG_NAME=

VOICE_GATEWAY_PORT=4100
WEB_PUBLIC_VOICE_GATEWAY_URL=ws://localhost:4100
# Shared secret between the web app server and the gateway's internal session API.
GATEWAY_INTERNAL_TOKEN=
# Comma-separated browser origins allowed to open interview streams.
GATEWAY_ALLOWED_ORIGINS=http://localhost:3000
# End-of-turn detection. End silence counts fully toward response latency.
VAD_THRESHOLD_DBFS=-40
VAD_MIN_SPEECH_MS=100
VAD_END_SILENCE_MS=500
# Let the LLM reword planned questions (adds full generation time to latency).
INTERVIEWER_LLM_REPHRASE=false
# Local /dev test page with a demo session. Never enable in production.
GATEWAY_DEV_PAGE=false

# Retention (days) for raw recordings, default for new studies
RETENTION_DEFAULT_DAYS=90

# ─── Majlis environment template ───────────────────────────────────────────
# Copy to .env and fill locally. Never commit real values.

NODE_ENV=development

# Data residency (PDPL). Must point to a region inside the Kingdom in production.
# Kept as a variable on purpose — no region is hard-coded anywhere in the code.
DATA_REGION=

# Database (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql://majlis:majlis_dev_password@localhost:5432/majlis

# Queue / cache
REDIS_URL=redis://localhost:6379

# Object storage for recordings (S3-compatible; MinIO locally)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=majlis-recordings
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Server-side encryption key id for recordings at rest
STORAGE_KMS_KEY_ID=

# ─── Provider adapters ─────────────────────────────────────────────────────
# Each is selected by name; "mock" is the default and needs no keys.
ASR_PROVIDER=mock
TTS_PROVIDER=mock
LLM_PROVIDER=mock
TELEPHONY_PROVIDER=mock
WHATSAPP_PROVIDER=mock

# Provider credentials — filled only after a provider is approved.
ASR_API_KEY=
TTS_API_KEY=
LLM_API_KEY=
LLM_MODEL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ─── Services ──────────────────────────────────────────────────────────────
VOICE_GATEWAY_PORT=4100
WEB_PUBLIC_VOICE_GATEWAY_URL=ws://localhost:4100

# Retention (days) for raw recordings, default for new studies
RETENTION_DEFAULT_DAYS=90

{
  "name": "@majlis/voice-gateway",
  "version": "0.0.0",
  "private": true,
  "description": "Realtime voice conversation gateway (streaming ASR → LLM → TTS)",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "tsx test/browser/e2e.ts"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.0",
    "@majlis/providers": "workspace:*",
    "fastify": "^5.12.0",
    "@majlis/dialect": "workspace:*",
    "@majlis/interviewer": "workspace:*",
    "@majlis/voice-client": "workspace:*",
    "@fastify/static": "^8.2.0",
    "@majlis/db": "workspace:*",
    "@majlis/storage": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.23.0",
    "ws": "^8.18.0",
    "@types/ws": "^8.18.0",
    "playwright": "1.63.0",
    "drizzle-orm": "^0.45.0"
  },
  "files": [
    "dist",
    "dev"
  ]
}

{
  "name": "@majlis/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Background jobs: final transcription, analysis, personas, retention deletion",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "start:once": "node dist/main.js --once"
  },
  "devDependencies": {
    "tsx": "^4.23.0",
    "drizzle-orm": "^0.45.0"
  },
  "dependencies": {
    "@majlis/analysis": "workspace:*",
    "@majlis/db": "workspace:*",
    "@majlis/providers": "workspace:*",
    "@majlis/storage": "workspace:*",
    "@majlis/dialect": "workspace:*",
    "@majlis/i18n": "workspace:*",
    "@majlis/interviewer": "workspace:*"
  }
}

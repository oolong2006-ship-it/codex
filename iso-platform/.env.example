# App role (RLS enforced)
DATABASE_URL=postgresql://iso_app:iso_app_dev@localhost:5432/iso_platform
# Owner role (migrations only — never used by the web app)
MIGRATION_DATABASE_URL=postgresql://iso_owner:iso_owner_dev@localhost:5432/iso_platform
# Optional AI provider. Without it the deterministic rules engine is used.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_MONTHLY_BUDGET_USD=50
# Set to "true" behind HTTPS so session cookies are Secure.
COOKIE_SECURE=false

# ========== شؤون — إعدادات الإنتاج ==========
# انسخ هذا الملف إلى .env (أو شغّل scripts/init-env.sh ليملأه لك). لا ترفع .env إلى GitHub أبداً.

# الدومين بدون www (يجب أن تشير سجلات DNS: @ و www و api إلى عنوان الخادم)
DOMAIN=shuoon.net
# بريد لتنبيهات شهادات HTTPS من Let's Encrypt
ACME_EMAIL=hello@shuoon.net

# أسرار — تُولَّد عشوائياً (openssl rand -hex 32)
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_EXPIRES_IN=12h

# حسابك كمالك للمنصة (بوابة /admin) — يُنشأ أو يُحدَّث عند كل تشغيل للخادم
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_NAME=مدير المنصة

# البريد الصادر (الفواتير والتذكيرات). اتركه فارغاً لحفظ الرسائل في سجل البوابة دون إرسال.
# Google Workspace: smtp.gmail.com / 587 / كلمة مرور تطبيق — Zoho: smtp.zoho.sa / 587 — Microsoft 365: smtp.office365.com / 587
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="شؤون <hello@shuoon.net>"

# توثيق الـ API على https://api.DOMAIN/api/docs (يُفضَّل إبقاؤه false في الإنتاج)
API_DOCS=false

# عدد أيام الاحتفاظ بالنسخ الاحتياطية
BACKUP_KEEP_DAYS=14

# ========== شؤون — إعدادات الإنتاج ==========
# شغّل scripts/init-env.sh ليُنشئ منه deploy/.env ويملأه لك. لا ترفع .env إلى GitHub أبداً.
#
# ⚠️ قاعدة الكتابة: ضع كل قيمة بين علامتي تنصيص مفردتين هكذا:  SMTP_PASS='abc$12 #x'
#    بدون التنصيص يحذف Docker ما بعد « #» ويستبدل ما بعد $ فتتغيّر كلمة المرور دون أن تنتبه.
#    القيمة نفسها لا يجوز أن تحتوي علامة التنصيص المفردة ' .

# الدومين بدون www (يجب أن تشير سجلات DNS: @ و www و api إلى عنوان الخادم)
DOMAIN='shuoon.net'
# بريد لتنبيهات شهادات HTTPS من Let's Encrypt
ACME_EMAIL='hello@shuoon.net'

# أسرار — تُولَّد عشوائياً (openssl rand -hex 32)
POSTGRES_PASSWORD=''
JWT_SECRET=''
JWT_EXPIRES_IN='12h'

# حسابك كمالك للمنصة (بوابة /admin).
# يُنشأ الحساب بهذه القيم عند أول تشغيل. لإعادة تعيين كلمة المرور لاحقاً (إذا نسيتها) ضع قيمة جديدة هنا
# ثم شغّل deploy.sh --no-pull: تُطبَّق الجديدة وتُلغى جلسات الدخول القائمة. يُنصح بتغييرها من البوابة بعد أول دخول.
PLATFORM_ADMIN_EMAIL=''
PLATFORM_ADMIN_PASSWORD=''
PLATFORM_ADMIN_NAME='مدير المنصة'

# البريد الصادر (الفواتير والتذكيرات). اتركه فارغاً لحفظ الرسائل في سجل البوابة دون إرسال.
# Google Workspace: smtp.gmail.com / 587 / كلمة مرور تطبيق — Zoho: smtp.zoho.sa / 587 — Microsoft 365: smtp.office365.com / 587
SMTP_HOST=''
SMTP_PORT='587'
SMTP_SECURE='false'
SMTP_USER=''
SMTP_PASS=''
SMTP_FROM='شؤون <hello@shuoon.net>'

# توثيق الـ API على https://api.DOMAIN/api/docs (يُفضَّل إبقاؤه false في الإنتاج)
API_DOCS='false'

# الفرع الذي يسحبه deploy.sh من GitHub. فارغ = الفرع الحالي على الخادم.
# لاحقاً استخدم فرع الإصدارات المستقر (مثل release) بدلاً من فروع التطوير.
DEPLOY_BRANCH=''

# ---------- النسخ الاحتياطي ----------
# عدد أيام الاحتفاظ بالنسخ على الخادم (deploy/backups)
BACKUP_KEEP_DAYS='14'

# (اختياري، يُنصح به) رابط «نبض» يُطلب بعد كل نسخة ناجحة، ويُطلب /fail عند الفشل — مثلاً من healthchecks.io.
# إذا لم يصل النبض في موعده يرسل لك الموقع بريداً. مثال: https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
BACKUP_HEARTBEAT_URL=''

# (اختياري، يُنصح به) نسخة مشفّرة خارج الخادم في تخزين متوافق مع S3 (مثل DigitalOcean Spaces).
# اتركها فارغة = نسخ محلي فقط. تُشفَّر كل نسخة بـ BACKUP_ENCRYPTION_PASSPHRASE قبل رفعها (GPG / AES-256).
# ⚠️ احفظ عبارة التشفير ومفاتيح Spaces في مدير كلمات مرور خارج الخادم: بدونها لا يمكن فك النسخ.
# مثال DigitalOcean Spaces فرانكفورت: fra1.digitaloceanspaces.com
OFFSITE_S3_ENDPOINT=''
# المنطقة، مثل fra1 (يمكن تركها فارغة)
OFFSITE_S3_REGION=''
# اسم الـ Bucket / Space، مثل shuoon-backups — ومجلد داخله
OFFSITE_S3_BUCKET=''
OFFSITE_S3_PREFIX='db/'
OFFSITE_S3_ACCESS_KEY=''
OFFSITE_S3_SECRET_KEY=''
# تُحذف من التخزين الخارجي النسخ الأقدم من هذا العدد من الأيام
OFFSITE_KEEP_DAYS='30'
# عبارة تشفير طويلة (20 حرفاً على الأقل)، مثلاً ناتج: openssl rand -base64 30
BACKUP_ENCRYPTION_PASSPHRASE=''

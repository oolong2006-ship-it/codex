DATABASE_URL=postgresql://taqam:taqam_dev@localhost:5432/taqam?schema=public
# used by `npm run test:e2e` (database is created/migrated automatically)
TEST_DATABASE_URL=postgresql://taqam:taqam_dev@localhost:5432/taqam_test?schema=public
# Required in production (NODE_ENV=production, e.g. the Docker image): at least 32 characters or the API refuses to boot.
# Dev/test fall back to a built-in key when unset. For docker compose, put it in taqam/.env: JWT_SECRET=$(openssl rand -hex 32)
JWT_SECRET=change-me-to-a-random-secret-of-32-plus-chars
JWT_EXPIRES_IN=12h
PORT=4100
CORS_ORIGIN=http://localhost:3100
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=600
# Behind a reverse proxy (e.g. Caddy in taqam/deploy) set TRUST_PROXY=1 so rate limits apply per visitor IP
TRUST_PROXY=
# API_DOCS=false hides the Swagger UI at /api/docs
API_DOCS=true
# Platform admin bootstrap: creates/refreshes this SUPER_ADMIN on API boot (leave empty to skip)
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
# Outgoing email (invoices, payment receipts, subscription reminders). Leave SMTP_HOST empty to send nothing:
# messages are then only stored in the admin email log (/admin/emails) with status LOGGED.
SMTP_HOST=
# 587 = STARTTLS (default), 465 = implicit TLS (set SMTP_SECURE=true)
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender shown to recipients (default: شؤون <hello@shuoon.net>)
SMTP_FROM="شؤون <hello@shuoon.net>"

# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://khatm:khatm_dev@localhost:5432/khatm
# Used only by scripts/db-setup.sh to create the role + database locally.
PGSUPER_URL=postgresql://postgres:postgres@localhost:5432/postgres

# ── App ──────────────────────────────────────────────────
# Public base URL (used in QR posters, wallet web-service URLs, Google save links).
APP_URL=http://localhost:3200
# 32+ random chars. Rotate by prepending a new "kid:secret" pair; old pairs keep verifying.
# Format: "kid:secret,kid:secret" — the FIRST pair signs new tokens.
CARD_TOKEN_KEYS=1:change-me-dev-only-card-token-secret-32chars
# Demo seed password (development only).
SEED_PASSWORD=KhatmDemo-2026

# ── Wallet provider: mock | live ─────────────────────────
WALLET_PROVIDER=mock

# Apple Wallet (required when WALLET_PROVIDER=live) — see docs/WALLET_SETUP.md
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_PASS_CERT_PEM_PATH=
APPLE_PASS_KEY_PEM_PATH=
APPLE_PASS_KEY_PASSPHRASE=
APPLE_WWDR_CERT_PEM_PATH=
# api.push.apple.com in production
APPLE_APNS_HOST=api.push.apple.com

# Google Wallet (required when WALLET_PROVIDER=live)
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON_PATH=

# ── Messaging provider: console | whatsapp ───────────────
MESSAGING_PROVIDER=console
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

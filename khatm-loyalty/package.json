{
  "name": "khatm-loyalty",
  "version": "0.1.0",
  "private": true,
  "description": "Khatm — Arabic-first digital loyalty cards (Apple Wallet / Google Wallet) for cafés and restaurants in Saudi Arabia",
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "next build",
    "start": "next start -p ${PORT:-3200}",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "db:setup": "bash scripts/db-setup.sh",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "worker": "tsx scripts/worker.ts",
    "verify": "npm run typecheck && npm run test && npm run build",
    "start:hosted": "npm run db:migrate && node -e \"process.exit(process.env.DEMO_SEED==='1'?0:1)\" && SEED_IF_EMPTY=1 npm run db:seed; npm run start",
    "predev": "node scripts/copy-fonts.mjs",
    "prebuild": "node scripts/copy-fonts.mjs",
    "marketing:build": "tsx scripts/build-marketing.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/alexandria": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@zxing/browser": "^0.2.1",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.16",
    "next": "^16.4.5",
    "node-forge": "^1.4.3",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/node-forge": "^1.3.14",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}

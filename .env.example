# ─────────────────────────────────────────────────────────────
# MASAR 34 — Environment template. Copy to .env and adjust.
# NEVER commit a real .env. Values below are DEV defaults only.
# ─────────────────────────────────────────────────────────────

# --- Postgres ---
POSTGRES_USER=masar
POSTGRES_PASSWORD=masar_dev_password
POSTGRES_DB=masar34
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- API (NestJS) ---
API_PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://masar:masar_dev_password@postgres:5432/masar34?schema=public
REDIS_URL=redis://redis:6379

# JWT — replace with strong secrets in any non-dev environment
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Password / security policy
BCRYPT_ROUNDS=12
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120

# Seed demo password (DEV ONLY — see README)
SEED_DEMO_PASSWORD=Masar34!Demo

# --- Ops Copilot via OmniRoute (optional) ---
# OpenAI-compatible gateway, e.g. `npx omniroute` → http://localhost:20128/v1
# (inside docker compose use http://host.docker.internal:20128/v1).
# Leave OMNIROUTE_BASE_URL empty to use the built-in rule-based briefing only.
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
# Model or combo names defined in OmniRoute: calm/watch → routine, elevated/critical → priority
OMNIROUTE_MODEL_ROUTINE=masar-routine
OMNIROUTE_MODEL_PRIORITY=masar-priority
OMNIROUTE_TIMEOUT_ROUTINE_MS=15000
OMNIROUTE_TIMEOUT_PRIORITY_MS=6000
COPILOT_CACHE_TTL_MS=60000

# --- Web (Next.js) ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000

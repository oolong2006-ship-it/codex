# ──────────────────────────────────────────────────────────────
# Supplier Intelligence Hub — environment template.
# Copy to .env and adjust. NEVER commit a real .env.
# ──────────────────────────────────────────────────────────────

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/supplier_hub?schema=public"

# --- NextAuth ---
# Generate a strong secret: `openssl rand -base64 32`
NEXTAUTH_SECRET="change-me-in-production-please-use-openssl-rand"
NEXTAUTH_URL="http://localhost:3000"

# --- File storage ---
# "local" writes uploads under ./storage (dev). Swap for S3/Supabase in prod.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage/uploads"
MAX_UPLOAD_MB="15"

# --- AI (Anthropic Claude) ---
# Optional. If unset, AI extraction/classification runs in heuristic fallback mode.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# --- Seed demo password (DEV ONLY) ---
SEED_DEMO_PASSWORD="Demo!Passw0rd"

# =====================================================================
# بوابة مشتريات فروع شركة مطاعم الناضج — نموذج متغيرات البيئة
#
# انسخ هذا الملف إلى .env.local ثم املأ القيم الحقيقية.
# ملف .env.local مستثنى في .gitignore ولا يُرفع إلى المستودع أبدًا.
# =====================================================================

# ---------------------------------------------------------------------
# الواجهة (تصل إلى المتصفح — عامة بطبيعتها ومحمية بسياسات RLS)
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://wdtylpgeyjuetarwtbev.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# ---------------------------------------------------------------------
# الخادم فقط — لا تضع هذه القيم في أي متغير يبدأ بـ NEXT_PUBLIC_
# ولا في ملفات الواجهة، ولا في المستودع.
# تُستخدم محليًا لتشغيل السكربتات، وتُضبط في Supabase كأسرار للدالة.
# ---------------------------------------------------------------------
SUPABASE_URL=https://wdtylpgeyjuetarwtbev.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-NEVER-COMMIT>

# عنوان الواجهة المنشورة — يُستخدم لبناء رابط التفعيل ولسياسة CORS
APP_BASE_URL=https://<your-app>.vercel.app

# النطاقات المسموح لها باستدعاء الواجهة البرمجية (مفصولة بفواصل)
# يُضبط كسر للدالة: supabase secrets set ALLOWED_ORIGINS=...
ALLOWED_ORIGINS=https://<your-app>.vercel.app

# سلسلة اتصال قاعدة البيانات — لتقرير فحص المخطط فقط
# من: Project Settings → Database → Connection string
DATABASE_URL=postgresql://postgres:<password>@db.wdtylpgeyjuetarwtbev.supabase.co:5432/postgres
